{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "plans_directory": ".cursor/plans",
  "mcp": {
    "codegraph": {
      "type": "local",
      "enabled": true,
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "cwd": "."
    }
  },
  "tools": {
    "grep": false,
    "glob": false
  }
}
